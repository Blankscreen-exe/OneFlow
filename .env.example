# Application Environment
# Options: development, production, test (default: development)
NODE_ENV=development
# Server port (default: 3000)
PORT=3000
# CORS allowed origin (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000
# Frontend URL for links in emails (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# Database Connection
DATABASE_URL=postgresql://postgres:postgresql@localhost:5432/one_flow
# Format: postgresql://user:password@host:port/database
# OR: mysql://user:password@host:port/database
# If not provided, falls back to SQLite (database.sqlite)

# Database Options (Development only)
# Set to 'true' to enable auto-sync (default: false)
DB_SYNCHRONIZE=false
# Set to 'true' to drop and recreate schema (default: false)
DROP_SCHEMA=false

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# ⚠️ REQUIRED in production - must be a strong random string
# Token expiration (default: 7d, e.g., 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Password Reset
# Token expiry in seconds (default: 3600 = 1 hour)
PASSWORD_RESET_TOKEN_EXPIRY=3600

# Email Provider Selection
# Options: console, resend, sendgrid, ses (default: console)
EMAIL_PROVIDER=console
# Default sender email (default: noreply@oneflow.com)
EMAIL_FROM=noreply@oneflow.com

# Resend Provider (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# SendGrid Provider (if EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# AWS SES Provider (if EMAIL_PROVIDER=ses)
SES_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxx
SES_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
SES_REGION=us-east-1

# AI Provider Selection # Options: console, openai, anthropic (default: console)
AI_PROVIDER=console

# OpenAI Provider (if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
OPENAI_MODEL=gpt-4

# Anthropic Provider (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Payment Provider
DEFAULT_PAYMENT_PROVIDER=stripe

# Stripe Configuration (Required for payments)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx 
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
STRIPE_DEFAULT_PLATFORM_FEE_RATE=10

# Invoice Settings
INVOICE_DUE_DAYS=30

# Overdue Invoice Reminders
# Cron schedule (default: 0 9 * * * = daily at 9 AM)
OVERDUE_REMINDER_SCHEDULE=0 9 * * *
# Comma-separated days overdue to send reminders (default: 7)    
OVERDUE_REMINDER_DAYS=7,14,21