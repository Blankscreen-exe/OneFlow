<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - OneFlow Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="text-center">
        <div class="mb-8">
            <h1 class="text-9xl font-bold text-gray-300">404</h1>
            <h2 class="text-3xl font-bold text-gray-800 mt-4">Page Not Found</h2>
            <p class="text-gray-600 mt-2">The page you're looking for doesn't exist.</p>
        </div>
        <div class="space-x-4">
            <a href="/admin/dashboard" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition duration-200">
                Go to Dashboard
            </a>
            <a href="/admin" class="inline-block bg-gray-200 text-gray-800 px-6 py-3 rounded-lg hover:bg-gray-300 transition duration-200">
                Go Home
            </a>
        </div>
    </div>
</body>
</html>

